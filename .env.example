# Copia este fichero a `.env` y rellena la clave.
#
# Token personal de https://codebase.helmholtz.cloud (ámbito `read_user`,
# caduca al año). Da acceso gratuito a Blablador: embeddings, generador y juez.
BLABLADOR_API_KEY=

# Opcional: sólo para la corrida con generador de pago (PROVEEDOR_RAG=openai).
OPENAI_API_KEY=

# NO escribas aquí las variables de cada corrida (EVAL_CORRIDA, EVAL_BANCO,
# RERANKER_MODEL, RERANK_K, BM25_STEMMING, ESTILO_RESPUESTA, PROVEEDOR_RAG,
# OPENAI_MODEL_RAG, PRESUPUESTO_USD...). `rag/config.py` carga este fichero con
# `override=True`, así que pisaría lo que pongas en la shell y todas las
# corridas acabarían escribiendo en el mismo sitio.
